#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Follow the pinned CWA service implementation; keep HA topology separate.
set -euo pipefail
# Only the HA storage bootstrap needs Supervisor access; upstream services run
# Calibre, ImageMagick and Ghostscript on untrusted books without the token.
unset SUPERVISOR_TOKEN HASSIO_TOKEN
exec bash /app/calibre-web-automated/root/etc/s6-overlay/s6-rc.d/cwa-ingest-service/run
