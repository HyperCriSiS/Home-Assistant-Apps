#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Follow the pinned CWA service implementation; keep HA topology separate.
set -euo pipefail
# Only the HA storage bootstrap needs Supervisor access; upstream services run
# Calibre, ImageMagick and Ghostscript on untrusted books without the token.
unset SUPERVISOR_TOKEN HASSIO_TOKEN
bash /app/calibre-web-automated/root/etc/s6-overlay/s6-rc.d/cwa-auto-library/run
# Upstream may create metadata.db as root after cwa-init's ownership pass.
# Repair our symlink-backed library, then verify as the actual service user.
python3 /opt/ha-cwa/library_permissions.py prepare
s6-setuidgid abc python3 /opt/ha-cwa/library_permissions.py check
